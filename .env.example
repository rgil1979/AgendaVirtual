# MongoDB connection string (replica set required for transactions)
# Local replica set example:  mongodb://localhost:27017/consultorio?replicaSet=rs0
# Atlas example:              mongodb+srv://user:password@cluster.mongodb.net/consultorio
DATABASE_URL="mongodb://localhost:27017/consultorio?replicaSet=rs0"

# JWT secret — generate with: openssl rand -hex 32
JWT_SECRET="change-me-to-a-random-secret"

# Seed credentials for the initial admin user (used only by prisma/seed.ts)
SEED_USERNAME="admin"
SEED_PASSWORD="change-me-before-first-run"
